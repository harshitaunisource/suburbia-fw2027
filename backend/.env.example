# Copy this file to .env and adjust as needed.

# Database. Defaults to a local SQLite file if unset -- fine for
# development. For production, point at a real Postgres instance:
DATABASE_URL=sqlite:///./suburbia_fw2027.db
# DATABASE_URL=postgresql+psycopg2://suburbia:suburbia@localhost:5432/suburbia_fw2027

# AI provider for Phase 5 (attribute extraction). "mock" needs no API
# key and runs entirely offline with keyword-based extraction -- good
# for getting the whole pipeline working first. Switch to "anthropic"
# for real AI-quality attribute extraction.
AI_PROVIDER=mock
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Where downloaded product/catalogue images are stored.
# STORAGE_ROOT=./storage
